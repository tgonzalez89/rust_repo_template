{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Rust: build",
      "type": "process",
      "command": "cargo",
      "args": [
        "build",
        "--locked",
        "--all-targets",
        "--all-features"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Rust: test",
      "type": "process",
      "command": "cargo",
      "args": [
        "test-all"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Rust: lint",
      "type": "process",
      "command": "cargo",
      "args": [
        "lint"
      ],
      "problemMatcher": [
        "$rustc"
      ]
    }
  ]
}
